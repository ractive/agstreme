IDD_NEWACCOUNTINFO DIALOG DISCARDABLE  0, 0, 291, 223
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Personal Information"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Pick a user name*",IDC_STATIC,42,15,62,8
    EDITTEXT        IDC_NEW_USERNAME,108,14,60,12,ES_AUTOHSCROLL
    LTEXT           "P&assword*",IDC_STATIC,42,31,36,8
    EDITTEXT        IDC_NEW_PASSWORD,108,30,60,12,ES_PASSWORD | 
                    ES_AUTOHSCROLL
    LTEXT           "Verify Password*",IDC_STATIC,42,48,54,8
    EDITTEXT        IDC_NEW_PASSWORD2,108,46,60,12,ES_PASSWORD | 
                    ES_AUTOHSCROLL
    LTEXT           "Email*",IDC_STATIC,42,64,36,8
    EDITTEXT        IDC_NEW_EMAIL,108,62,130,12,ES_AUTOHSCROLL
    LTEXT           "Age",IDC_STATIC,42,86,14,8
    COMBOBOX        IDC_COMBO_AGE,108,83,61,91,CBS_DROPDOWNLIST | WS_VSCROLL | 
                    WS_TABSTOP
    LTEXT           "Gender",IDC_STATIC,42,100,24,8
    COMBOBOX        IDC_COMBO_GENDER,108,98,61,49,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "City*",IDC_STATIC,42,122,36,8
    EDITTEXT        IDC_NEW_CITY,108,120,95,12,ES_AUTOHSCROLL
    LTEXT           "State",IDC_STATIC,42,137,36,8
    EDITTEXT        IDC_NEW_STATE,108,135,15,12,ES_AUTOHSCROLL
    LTEXT           "ZIP Code",IDC_STATIC,42,153,36,8
    EDITTEXT        IDC_NEW_ZIP_CODE,108,151,28,12,ES_AUTOHSCROLL
    LTEXT           "Country*",IDC_STATIC,42,169,26,8
    COMBOBOX        IDC_COMBO_COUNTRY,108,167,79,79,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_NEW_HEARD_ABOUT,42,195,203,12,ES_AUTOHSCROLL
    GROUPBOX        "Account Information (fields with * are required)",
                    IDC_STATIC,7,0,277,214,WS_GROUP | WS_TABSTOP
    LTEXT           "How did you hear about us?",IDC_STATIC,42,184,117,8
END

IDD_TRYCREATEACCOUNT DIALOGEX 0, 0, 186, 132
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Account creation"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "Cancel",IDCANCEL,64,111,50,14
    LTEXT           "Connection status:",IDC_STATIC,7,7,60,8
    CTEXT           "Trying to connect...",IDC_STATUS,7,18,172,23,0,
                    WS_EX_STATICEDGE
    CONTROL         "Animate1",IDC_ANIMATION,"SysAnimate32",ACS_TRANSPARENT | 
                    ACS_AUTOPLAY | WS_TABSTOP,7,48,172,20
    LTEXT           "If this fails, try to create your account",IDC_STATIC,7,
                    84,116,8
    LTEXT           "here",IDC_CREATEACCOUNT,125,84,15,8
END

IDD_FORMATERRORDLG DIALOGEX 0, 0, 270, 250
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Filename format error"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,213,229,50,14
    LTEXT           "The filename format you entered is invalid",
                    IDC_TITLEERROR,7,7,131,8
    LTEXT           "",IDC_REASON,7,22,256,18,0,WS_EX_CLIENTEDGE
    LTEXT           "<A>",IDC_STATIC,19,56,14,8
    LTEXT           "<L>",IDC_STATIC,19,67,13,8
    LTEXT           "<T>",IDC_STATIC,127,56,14,8
    LTEXT           "<N>",IDC_STATIC,127,67,14,8
    LTEXT           "You must define at least one parameter!\r\nSongs downloaded form AudioGalaxy always have the format ""Artist - Title.mp3""\r\nwhich is ""<A> - <T>""",
                    IDC_STATIC,7,87,256,26
    LTEXT           "for  ""Artist""",IDC_STATIC,43,56,35,8
    LTEXT           "for  ""Album""",IDC_STATIC,43,67,39,8
    LTEXT           "for  ""Title""",IDC_STATIC,151,56,33,8
    LTEXT           "for  the tracknumber",IDC_STATIC,151,67,64,8
    LTEXT           "<A> - <T>",IDC_STATIC,15,126,32,8
    LTEXT           "<A>_<L>_<T>",IDC_STATIC,15,138,46,8
    LTEXT           "matches",IDC_STATIC,71,126,28,8
    LTEXT           "matches",IDC_STATIC,71,138,28,8
    LTEXT           "Madonna - American pie.mp3",IDC_STATIC,114,126,93,8
    LTEXT           "U2_Rattle and Hum_Desire.mp3",IDC_STATIC,114,138,103,8
    LTEXT           "<L> (<N>) - <T>",IDC_STATIC,15,151,51,8
    LTEXT           "matches",IDC_STATIC,71,151,28,8
    LTEXT           "Thriller (5) - Beat it.mp3",IDC_STATIC,114,151,73,8
    GROUPBOX        " Parameters ",IDC_STATIC,7,45,256,35
    GROUPBOX        " Examples ",IDC_STATIC,7,116,256,49
    GROUPBOX        "Tipps ",IDC_STATIC,7,171,256,55
    LTEXT           "- Keep the naming of your files consistent and use always the same format",
                    IDC_STATIC,13,181,232,8
    LTEXT           "- Use ""special"" characters (like - ) to separate the parts of the name",
                    IDC_STATIC,13,191,212,8
    LTEXT           "It's easier to read and to get information: ""U2 Rattle and Hum desire.mp3""\r\nis a bad example!",
                    IDC_STATIC,17,201,239,19
END

IDD_CHOOSETRACKDLG DIALOGEX 0, 0, 203, 206
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Choose Track"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,7,184,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,146,184,50,14
    LTEXT           "Please choose the track that matches the song:",
                    IDC_STATIC,7,72,152,8
    LISTBOX         IDC_TRACKLIST,7,87,189,90,LBS_NOINTEGRALHEIGHT | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "Artist:",IDC_STATIC,7,33,18,8
    LTEXT           "Album:",IDC_STATIC,7,44,22,8
    LTEXT           "File:",IDC_STATIC,7,55,14,8
    LTEXT           "A matching album has been found, but the track could\r\nnot be identified",
                    IDC_STATIC,7,7,189,21
    LTEXT           "",IDC_ARTIST,32,33,164,10,SS_CENTERIMAGE,
                    WS_EX_STATICEDGE
    LTEXT           "",IDC_ALBUM,32,44,164,10,SS_CENTERIMAGE,
                    WS_EX_STATICEDGE
    LTEXT           "",IDC_FILENAME,32,55,164,10,SS_CENTERIMAGE,
                    WS_EX_STATICEDGE
END

IDD_SCANWAIT DIALOGEX 0, 0, 186, 114
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    LTEXT           "The audiogalaxy satellite is scanning your MP3 files",
                    IDC_STATIC,7,7,162,8
    CTEXT           "Please wait...",IDC_INFO,7,21,172,8
    CONTROL         "Animate1",IDC_ANIMATE1,"SysAnimate32",ACS_CENTER | 
                    ACS_TRANSPARENT | ACS_AUTOPLAY | WS_TABSTOP,63,34,59,49
    LTEXT           "",IDC_SCANINFO,7,96,172,11,SS_CENTERIMAGE,
                    WS_EX_STATICEDGE
END

IDD_DAOERROR DIALOG DISCARDABLE  0, 0, 186, 118
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Database installation"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,129,97,50,14
    LTEXT           "You don't have all necessary files installed on your\r\nmachine that are required for AGStreme to use the music database.\r\n\r\nPlease download the following file, upzip it and start\r\nsetup.exe in the folder ""Disk 1"":",
                    IDC_STATIC,7,7,172,61
    LTEXT           "http://www.ractive.ch/gpl/download/DAOInst.zip",
                    IDC_DAOURL,7,68,158,8
END

IDD_DOWNLOADLISTDLG DIALOGEX 0, 0, 338, 254
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Download list"
FONT 8, "MS Sans Serif"
BEGIN
    EDITTEXT        IDC_ARTIST,49,20,151,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_SONG,49,36,151,12,ES_AUTOHSCROLL
    CONTROL         "Always same artist",IDC_SAMEARTIST,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,209,22,73,10
    DEFPUSHBUTTON   "Add to downloadlist",IDOK,49,53,97,14
    CONTROL         "List1",IDC_SONGLIST,"SysListView32",LVS_REPORT | 
                    LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,7,72,324,141
    PUSHBUTTON      "Remove from downloadlist",IDC_REMOVEFROMLIST,132,233,97,
                    14
    PUSHBUTTON      "OK",IDC_ADDTOQUEUE,7,233,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,281,233,50,14
    LTEXT           "Enter songs you want to download:",IDC_STATIC,7,7,112,8
    LTEXT           "Artist:",IDC_STATIC,7,24,18,8
    LTEXT           "Songtitle:",IDC_STATIC,7,39,30,8
    LTEXT           "Bitrate:",IDC_STATIC,209,39,23,8
    COMBOBOX        IDC_BITRATECOMBO,244,36,81,111,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "",IDC_STATUS,7,216,324,12,SS_CENTERIMAGE,
                    WS_EX_STATICEDGE
END


