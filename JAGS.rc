//
// Dialog
//

IDD_NEWACCOUNTINFO DIALOG DISCARDABLE  0, 0, 291, 223
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Personal Information"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Pick a user name*",IDC_STATIC,42,15,62,8
    EDITTEXT        IDC_NEW_USERNAME,108,14,60,12,ES_AUTOHSCROLL
    LTEXT           "P&assword*",IDC_STATIC,42,31,36,8
    EDITTEXT        IDC_NEW_PASSWORD,108,30,60,12,ES_PASSWORD | 
                    ES_AUTOHSCROLL
    LTEXT           "Verify Password*",IDC_STATIC,42,48,54,8
    EDITTEXT        IDC_NEW_PASSWORD2,108,46,60,12,ES_PASSWORD | 
                    ES_AUTOHSCROLL
    LTEXT           "Email*",IDC_STATIC,42,64,36,8
    EDITTEXT        IDC_NEW_EMAIL,108,62,130,12,ES_AUTOHSCROLL
    LTEXT           "Age",IDC_STATIC,42,86,14,8
    COMBOBOX        IDC_COMBO_AGE,108,83,61,91,CBS_DROPDOWNLIST | WS_VSCROLL | 
                    WS_TABSTOP
    LTEXT           "Gender",IDC_STATIC,42,100,24,8
    COMBOBOX        IDC_COMBO_GENDER,108,98,61,49,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "City*",IDC_STATIC,42,122,36,8
    EDITTEXT        IDC_NEW_CITY,108,120,95,12,ES_AUTOHSCROLL
    LTEXT           "State",IDC_STATIC,42,137,36,8
    EDITTEXT        IDC_NEW_STATE,108,135,15,12,ES_AUTOHSCROLL
    LTEXT           "ZIP Code",IDC_STATIC,42,153,36,8
    EDITTEXT        IDC_NEW_ZIP_CODE,108,151,28,12,ES_AUTOHSCROLL
    LTEXT           "Country*",IDC_STATIC,42,169,26,8
    COMBOBOX        IDC_COMBO_COUNTRY,108,167,79,79,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_NEW_HEARD_ABOUT,42,195,203,12,ES_AUTOHSCROLL
    GROUPBOX        "Account Information (fields with * are required)",
                    IDC_STATIC,7,0,277,214,WS_GROUP | WS_TABSTOP
    LTEXT           "How did you hear about us?",IDC_STATIC,42,184,117,8
END

IDD_EMAILOPTIONS DIALOG DISCARDABLE  0, 0, 291, 226
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "EMail Options"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "Audiogalaxy Newsletter Options",IDC_STATIC,7,1,277,218,
                    WS_GROUP | WS_TABSTOP
    LTEXT           "Sign up for the Audiogalaxy Newsletter and receive up to date info on Audiogalaxy as well as special offers on Electronics, Music, and more.",
                    IDC_STATIC,11,12,226,20
    LTEXT           "Your email address will not be sold or given to any outside parties.",
                    IDC_STATIC,11,33,200,8
    CONTROL         "All Categories",IDC_EMAIL_OPT1,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,15,47,58,11
    CONTROL         "Consumer Electronics (like MP3 players)",IDC_EMAIL_OPT2,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,58,143,10
    CONTROL         "Computers && Software",IDC_EMAIL_OPT3,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,15,68,89,10
    CONTROL         "Cell Phones/Internet Communications",IDC_EMAIL_OPT4,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,78,150,10
    CONTROL         "Books, Music &&Movies",IDC_EMAIL_OPT5,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,15,88,93,10
    CONTROL         "Cars",IDC_EMAIL_OPT6,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,15,98,30,10
    CONTROL         "Entertainment && Leisure",IDC_EMAIL_OPT7,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,15,108,82,10
    CONTROL         "Food / Drinks",IDC_EMAIL_OPT8,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,15,118,57,10
    CONTROL         "Sports",IDC_EMAIL_OPT9,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,15,128,36,10
    CONTROL         "Travel",IDC_EMAIL_OPT10,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,15,138,36,10
    CONTROL         "Free Stuff",IDC_EMAIL_OPT11,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,15,148,44,10
    CONTROL         "Sweepstakes",IDC_EMAIL_OPT12,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,15,158,57,10
    LTEXT           "By checking the above boxes I agree that Audiogalaxy may send me information relating to the interest categories and the demographic information I have specified. I understand that I may cancel or modify my ",
                    IDC_STATIC,11,171,221,26
    LTEXT           "subscription to the Audiogalaxy Newsletter and/or options at any time by coming to Audiogalaxy's website and updating my profile.",
                    IDC_STATIC,11,195,221,18
END

IDD_TRYCREATEACCOUNT DIALOGEX 0, 0, 186, 105
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Account creation"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "Cancel",IDCANCEL,64,84,50,14
    LTEXT           "Connection status:",IDC_STATIC,7,7,60,8
    CTEXT           "Trying to connect...",IDC_STATUS,7,18,172,23,0,
                    WS_EX_STATICEDGE
    CONTROL         "Animate1",IDC_ANIMATION,"SysAnimate32",ACS_TRANSPARENT | 
                    ACS_AUTOPLAY | WS_TABSTOP,7,48,172,20
END


