/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "Create a new account...",     ID_NEWACCOUNT
        MENUITEM SEPARATOR
        MENUITEM "Preferences...",              ID_PREFERENCES
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Shares"
    BEGIN
        MENUITEM "Add new share",               ID_ADDSHARE
        MENUITEM "Remove this share",           ID_REMOVESHARE
        MENUITEM "Set as download directory",   ID_SETASDOWNLOADDIR
    END
    POPUP "F&avorites"
    BEGIN
        MENUITEM "Add to favorites",            ID_ADDTOFAVORITES
        MENUITEM SEPARATOR
        MENUITEM "",                            ID_FILE_MRU_FILE1
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Extras"
    BEGIN
        MENUITEM "&Delete music database",      ID_DELDB
        MENUITEM "&Reset connection",           ID_EXTRAS_RESETCONNECTION
        MENUITEM "&Create random playlist",     ID_PLAYLISTGEN
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Help...",                    ID_HELP
        MENUITEM "&About AGStreme...",          ID_APP_ABOUT
    END
END

IDR_TRAY MENU DISCARDABLE 
BEGIN
    POPUP "TrayMenu"
    BEGIN
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
END

IDR_BARS MENU DISCARDABLE 
BEGIN
    POPUP "Bars"
    BEGIN
        MENUITEM "&Shares",                     ID_SHOWSHARES
        MENUITEM "&MP3 files",                  ID_SHOWMP3
        MENUITEM "&File transfer",              ID_SHOWTRANSFER
        MENUITEM "M&P3 info",                   ID_SHOWMP3INFO
        MENUITEM "Fa&vorites",                  ID_SHOWFAVORITES
        MENUITEM "&Transfer statistics",        ID_SHOWTRANSFERRATE
    END
END

IDR_TREECONTEXTMENU MENU DISCARDABLE 
BEGIN
    POPUP "AGStreme"
    BEGIN
        MENUITEM "Set as download directory",   ID_SETASDOWNLOADDIR
        MENUITEM "Remove this share",           ID_REMOVESHARE
    END
END

IDR_SONGCONTEXT MENU DISCARDABLE 
BEGIN
    POPUP "SongContext"
    BEGIN
        MENUITEM "Song info",                   ID_SONGINFO
        MENUITEM "Choose version...",           ID_CHOOSEVERSION
        POPUP "Queue songs"
        BEGIN
            MENUITEM "Most popular version",        ID_QUEUESONGS
            MENUITEM "128 kbps version",            ID_QUEUE128
            MENUITEM "160 kbps version",            ID_QUEUE160
            MENUITEM "192 kbps version",            ID_QUEUE192
            MENUITEM "256 kbps version",            ID_QUEUE256
            MENUITEM "320 kbps version",            ID_QUEUE320
        END
    END
END


