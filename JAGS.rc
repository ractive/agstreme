/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "File"
    BEGIN
        MENUITEM "Create a new account...",     ID_NEWACCOUNT
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "Shares"
    BEGIN
        MENUITEM "Add new share",               ID_ADDSHARE
        MENUITEM "Remove this share",           ID_REMOVESHARE
        MENUITEM "Set as download directory",   ID_SETASDOWNLOADDIR
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Help...",                    ID_HELP
        MENUITEM "&About JAGS...",              ID_APP_ABOUT
    END
END

IDR_TRAY MENU DISCARDABLE 
BEGIN
    POPUP "TrayMenu"
    BEGIN
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
END

IDR_BARS MENU DISCARDABLE 
BEGIN
    POPUP "Bars"
    BEGIN
        MENUITEM "Shares",                      ID_SHOWSHARES
        MENUITEM "MP3 files",                   ID_SHOWMP3
        MENUITEM "File transfer",               ID_SHOWTRANSFER
        MENUITEM "Transfer statistics",         ID_SHOWTRANSFERRATE
        MENUITEM "MP3 info",                    ID_SHOWMP3INFO
    END
END

IDR_TREECONTEXTMENU MENU DISCARDABLE 
BEGIN
    POPUP "JAGS"
    BEGIN
        MENUITEM "Set as download directory",   ID_SETASDOWNLOADDIR
        MENUITEM "Remove this share",           ID_REMOVESHARE
    END
END


